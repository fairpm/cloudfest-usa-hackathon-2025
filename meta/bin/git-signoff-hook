#!/usr/bin/env bash

function die () {
  echo "$@" >&2
  exit 1
}

name=$(git config user.name)
email=$(git config user.email)

[[ -n "$name"  ]] || die "empty git config user.name"
[[ -n "$email" ]] || die "empty git config user.email"

git interpret-trailers \
  --if-exists doNothing \
  --trailer "Signed-off-by: $name <$email>" \
  --in-place \
  "$1"
