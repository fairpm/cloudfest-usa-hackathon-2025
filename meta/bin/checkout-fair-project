#!/usr/bin/env bash

here=$(dirname "$0") && source "$here"/prelude.bash

repo=$(repo_url "${1:-}") || die "Usage: $0 <repo-name-or-url>"
base=$(basename "$repo")

mkdir -p projects
cd projects

dest=$(pwd)/$base

if [[ -d $base ]]; then
  cd "$base"
  git pull
  echo "Successfully updated $repo in $dest"
else
  git clone "$repo" "$@"
  echo "Successfully cloned $repo to $dest"
  [[ -n ${NO_INSTALL_HOOK:-} ]] || cp -v ../meta/bin/git-signoff-hook "$dest"/.git/hooks/prepare-commit-msg
fi

